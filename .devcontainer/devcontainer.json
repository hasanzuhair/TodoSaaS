{
  "name": "TodoSaaS Production Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.dotnet"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "TodoSaaS.sln",
        "omnisharp.enableRoslynAnalyzers": true
      },
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-docker",
        "humao.rest-client"
      ]
    }
  },
  "forwardPorts": [8080, 8085, 3000, 16686, 15672, 8025, 9001],
  "postCreateCommand": "docker compose up -d && dotnet restore"
}
