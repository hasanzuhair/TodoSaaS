{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=todos_db;Username=postgres;Password=localpassword",
    "Redis": "redis:6379"
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Username": "guest",
    "Password": "guest"
  },
  "Storage": {
    "BucketName": "todosaas-files",
    "ServiceUrl": "http://minio:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin"
  },
  "Email": {
    "Host": "mailpit",
    "Port": 1025,
    "Sender": "noreply@todosass.com"
  },
  "Stripe": {
    "SecretKey": "sk_test_mock_key",
    "WebhookSecret": "whsec_mock_key",
    "ProPlanPriceId": "price_pro_subscription"
  },
  "Auth": {
    "JwtSecret": "SuperSecretTodoSaaSKeyForLocalDevelopmentAndTestingPurposesOnly1234567890",
    "Issuer": "TodoSaaS",
    "Audience": "TodoSaaS.Clients",
    "DevApiKey": "todosaas-local-dev-key"
  },
  "Sentry": {
    "Dsn": "",
    "TracesSampleRate": 1.0
  },
  "ReverseProxy": {
    "Routes": {
      "frontend-route": {
        "ClusterId": "frontend-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "frontend-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://frontend:3000"
          }
        }
      }
    }
  },
  "FeatureManagement": {
    "AiTaskSummary": true,
    "BetaDarkLaunch": false,
    "RealTimeCollaboration": true,
    "AdvancedAnalytics": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://jaeger:4317"
  }
}
