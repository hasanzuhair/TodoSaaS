{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Environment": "Staging",
  "ConnectionStrings": {
    "Postgres": "Host=staging-postgres.internal;Port=5432;Database=todos_staging;Username=postgres;Password=STAGING_PASSWORD",
    "Redis": "staging-redis.internal:6379"
  },
  "RabbitMQ": {
    "Host": "staging-rabbitmq.internal",
    "Username": "staging_user",
    "Password": "STAGING_PASSWORD"
  },
  "Storage": {
    "BucketName": "todosaas-staging-files",
    "ServiceUrl": "https://s3.staging.yourdomain.com",
    "AccessKey": "STAGING_ACCESS_KEY",
    "SecretKey": "STAGING_SECRET_KEY"
  },
  "Email": {
    "Host": "smtp.resend.com",
    "Port": 587,
    "Sender": "staging-alerts@yourdomain.com"
  },
  "Stripe": {
    "SecretKey": "sk_test_STAGING_KEY",
    "WebhookSecret": "whsec_STAGING_KEY",
    "ProPlanPriceId": "price_staging_pro_plan"
  },
  "Auth": {
    "Authority": "https://auth-staging.yourdomain.com",
    "Audience": "TodoSaaS.Clients",
    "Issuer": "https://auth-staging.yourdomain.com"
  },
  "Sentry": {
    "Dsn": "https://sentry_staging_key@sentry.io/project_id",
    "Environment": "staging",
    "TracesSampleRate": 0.5
  },
  "FeatureManagement": {
    "AiTaskSummary": true,
    "BetaDarkLaunch": true,
    "RealTimeCollaboration": true,
    "AdvancedAnalytics": true
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://staging-tempo.monitoring.svc:4317"
  }
}
